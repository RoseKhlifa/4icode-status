# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDEA
.idea

combined.log
error.log

.playwright-mcp
.mcp.json

# 4i.codes 状态: 探测数据 + 私密配置
