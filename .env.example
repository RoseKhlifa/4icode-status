# =============================================================
# 4i.codes 状态看板 环境变量
# =============================================================

# ------- provider 配置 -------
# 方式一 (推荐生产): 把整段 JSON 写在 PROVIDERS_JSON 环境变量里,注意转义
# PROVIDERS_JSON=[{"name":"GPT-5 (主渠道)","type":"openai","endpoint":"https://api.4i.codes/v1/chat/completions","model":"gpt-5-mini","apiKey":"sk-xxx","groupName":"主渠道","enabled":true}]
#
# 方式二 (推荐本地开发): 在项目根写 data/providers.json (被 .gitignore 忽略, 不入库)
# 或指定绝对路径:
# STATUS_PROVIDERS_PATH=/etc/4i-status/providers.json

# ------- SQLite 数据文件位置 -------
# 默认: <cwd>/data/status.db
# STATUS_DB_PATH=/var/lib/4i-status/status.db

# ------- 端口 -------
# npm run dev / npm start 默认 8800 (在 package.json scripts 里)
# 如需改成别的, 在这里覆盖 (Node 直起时 Next.js 会读 PORT)
# PORT=8800

# ------- basePath (反代场景, ⚠ build 时冻结) -------
# 用于 nginx 反代到子路径的场景, 如 https://4i.codes/status/.
# ⚠ 关键: 这个值在 `next build` 时被烘进产物, 影响所有 _next/static/* 资源的 URL 前缀.
#    每次重 build 都必须带上, 否则 asset 会走 https://4i.codes/_next/... 被 nginx 兜底吃掉,
#    浏览器报 "Refused to execute script ... MIME type ('text/html')".
#
# 生产 (nginx 反代到 /status/): 必须设为 /status
# 本地 dev (直接 localhost:8800 访问): 留空
#
# 推荐做法 (二选一):
#   [A] 写到 .env.production 并 commit, npm run build 自动读取
#   [B] shell 里显式带上: STATUS_BASE_PATH=/status npm run build
#
# STATUS_BASE_PATH=/status

# ------- 管理端 -------
# 首次启动会自动生成 12 位随机密码打印到日志; 也可以在这里预置
# ADMIN_INITIAL_PASSWORD=your-strong-password

# ------- 轮询参数 -------
# 探测间隔 (秒, 范围 15-600)
CHECK_POLL_INTERVAL_SECONDS=60
# 单批并发数 (1-20)
CHECK_CONCURRENCY=8
# 历史保留天数 (7-365)
HISTORY_RETENTION_DAYS=30
