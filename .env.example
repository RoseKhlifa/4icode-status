# =============================================================
# 4i.codes 状态看板 环境变量
# =============================================================

# ------- provider 配置 -------
# 方式一 (推荐生产): 把整段 JSON 写在 PROVIDERS_JSON 环境变量里,注意转义
# PROVIDERS_JSON=[{"name":"GPT-5 (主渠道)","type":"openai","endpoint":"https://api.4i.codes/v1/chat/completions","model":"gpt-5-mini","apiKey":"sk-xxx","groupName":"主渠道","enabled":true}]
#
# 方式二 (推荐本地开发): 在项目根写 data/providers.json (被 .gitignore 忽略, 不入库)
# 或指定绝对路径:
# STATUS_PROVIDERS_PATH=/etc/4i-status/providers.json

# ------- SQLite 数据文件位置 -------
# 默认: <cwd>/data/status.db
# STATUS_DB_PATH=/var/lib/4i-status/status.db

# ------- 轮询参数 -------
# 探测间隔 (秒, 范围 15-600)
CHECK_POLL_INTERVAL_SECONDS=60
# 单批并发数 (1-20)
CHECK_CONCURRENCY=8
# 历史保留天数 (7-365)
HISTORY_RETENTION_DAYS=30
